# Application
APP_NAME=Release Notes Manager
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/release_notes.db

# AI Provider (groq, openai, anthropic, gemini)
AI_PROVIDER=groq

# Groq Configuration (Default)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# Jira Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# GitHub Configuration
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_API_URL=https://api.github.com

# Confluence Configuration (Optional)
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_SPACE=RELEASE

# Job Queue
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT=300
JOB_CLEANUP_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# File Upload
MAX_UPLOAD_SIZE=10485760
